# 复制成 .env 后填入自己的值。注意：.env 不要提交到 git，不要发给别人。
# DeepSeek API Key：去 https://platform.deepseek.com 注册并充值几块钱，
# 在「API Keys」里新建一个 Key，粘贴到下面。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OCR 方案：tesseract（本地免费）或 cloud（云端，见 app/ocr.py 的 ocr_with_cloud 预留函数）
OCR_PROVIDER=tesseract

# 每个 IP 每天最多调 /api/extract 的次数，防别人刷你的 API 账单
EXTRACT_DAILY_LIMIT=20

# 账号系统：JWT 签名密钥。本地开发不填也能跑（启动时随机生成并打印警告），
# 但服务重启后之前签发的 token 全部失效；Render 上必须在环境变量里配一个
# 固定值（Dashboard → Environment → 添加 JWT_SECRET），否则每次部署
# 部署都会把所有用户踢下线。生成一个：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# SQLite 文件位置（相对 backend/ 目录）；不填则默认 data/muggle.db
MWC_DB_PATH=data/muggle.db
